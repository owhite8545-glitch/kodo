# ==============================================================================
# KODŌ E-COMMERCE CONFIGURATION
# ==============================================================================

# Canonical Base URL (Strictly required in production builds)
NEXT_PUBLIC_BASE_URL=https://kodo-livid.vercel.app

# Mode Switcher: "demo" (default) or "live"
# Strictly deterministic: "live" enables Live Mode; anything else is Demo Mode.
COMMERCE_MODE=demo

# ------------------------------------------------------------------------------
# VERCEL CLOUD DEMO MODE (Upstash Redis via Vercel Marketplace)
# ------------------------------------------------------------------------------
# Mandatory for Cloud Demo Mode in production.
# If missing in production, OrderRepository fails explicitly.
# Local development (localhost:3000) uses the in-memory adapter with zero setup.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ------------------------------------------------------------------------------
# LIVE PRODUCTION MERCHANT MODE (Turnkey Merchant Activation)
# ------------------------------------------------------------------------------
# Required ONLY when COMMERCE_MODE=live.
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
POSTGRES_URL=postgres://user:password@host:5432/kodo_db
