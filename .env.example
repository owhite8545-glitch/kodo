# KODŌ Storefront — Environment Configuration
# Copy this file to `.env.local` for local overrides. None of these are required
# to run the storefront in Demo / Portfolio mode.

# ── Site URL (Optional on Vercel: auto-detected from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL)
# Set explicitly if using a custom production domain locally or on non-Vercel hosts.
# NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# ── Commerce Mode: "demo" (default, zero external keys needed) or "live" (requires Stripe keys below)
COMMERCE_MODE="demo"

# ── Demo Receipt Signing Secret (Optional; defaults to a deterministic non-production key)
# DEMO_SIGNING_SECRET="replace-with-32-byte-hex-secret"

# ── Upstash Redis (Optional — enables multi-instance persistent order records in production)
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Stripe Checkout & Webhooks (Required only when COMMERCE_MODE="live")
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Concierge Inquiry Webhook (Optional — POST JSON notifications to Slack, Zapier, Make, or CRM)
# CONCIERGE_WEBHOOK_URL="https://hooks.example.com/concierge"
